#!/bin/sh
# Git Pre-Push Hook: Final guard before pushing commits to remote repository

if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_BIN=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    PYTHON_BIN="python"
fi

$PYTHON_BIN scripts/check_secrets.py --pre-push
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [Git Guard] Push ABORTED: Sensitive credentials or files detected!"
    echo ""
    exit 1
fi

exit 0
