#!/bin/sh
# Git Pre-Commit Security Guard
export PYTHONIOENCODING=utf-8

if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_BIN=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON_BIN="py"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    echo "[Git Guard] Python executable not found to run security scanner!"
    exit 1
fi

"$PYTHON_BIN" scripts/check_secrets.py --staged
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "[Git Guard] Commit ABORTED because sensitive credentials or files were detected!"
    echo "   Please unstage the offending files using: git reset HEAD <file>"
    echo ""
    exit 1
fi

exit 0
