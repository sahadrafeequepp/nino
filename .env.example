# Server Settings
HOST=127.0.0.1
PORT=8000

# Authentication (Bearer token, compared in constant time)
AUTH_TOKEN=change-me-to-a-secure-token

# Model & Adapter Configuration
# Options: 'ollama' (100% local on-device)
MODEL_ADAPTER=ollama
MODEL_NAME=gemma2:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434


# Embeddings & Vector Search (Local via Ollama)
EMBED_MODEL=nomic-embed-text

# Memory & Persistence
DB_PATH=data/nino.db
SENSITIVE_MEMORY=false
DEBUG_RETRIEVAL=false
TOKEN_BUDGET_TOTAL=4096
TOKEN_BUDGET_MEMORY=1200
# Optional: 32-byte urlsafe base64 key for Fernet field-level encryption at rest
MEMORY_ENCRYPTION_KEY=

# Privacy & Security
ALLOW_EXTERNAL_PROVIDERS=false

# Tool Execution & Security Tiers
MAX_TOOL_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=30.0
TOTAL_TOOL_TIMEOUT_SECONDS=120.0
TOOL_OUTPUT_MAX_CHARS=4000
ALLOW_RESTRICTED_TOOLS=false
CONFIRMATION_EXPIRY_MINUTES=5
ALLOWED_DIRS=.,test_notes,data
ENABLE_WEB_SEARCH=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
ENABLE_CODE_EXECUTION=false
CODE_EXECUTION_TIMEOUT=10.0

# Audit Logging
LOG_CONTENT=false
AUDIT_LOG_PATH=logs/audit.jsonl

# Voice Pipeline (Phase 4)
VOICE_ENABLED=true
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
VAD_THRESHOLD=0.5
VAD_SILENCE_TIMEOUT_MS=600
STT_MODEL=base.en
STT_COMPUTE_TYPE=int8
STT_DEVICE=auto
TTS_ADAPTER=piper
TTS_VOICE=en_US-lessac-medium
TTS_SPEED=1.0
STORE_AUDIO=false
VOICE_DUPLEX_MODE=half_duplex

# Proactivity & Automations (Phase 5)
PROACTIVE_ENABLED=true
MAX_PROACTIVE_PER_HOUR=3
MAX_PROACTIVE_PER_DAY=10
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
DAILY_BRIEFING_TIME=08:30
WEATHER_ENABLED=false
WEATHER_COARSE_LOCATION=
DEFAULT_LATITUDE=0.0
DEFAULT_LONGITUDE=0.0
DEFAULT_CITY="City, Country"
USER_TIMEZONE=UTC

# Home Assistant Integration (Phase 5)
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_ALLOWED_ENTITIES=
HA_DRY_RUN=false
HA_ENABLE_RESTRICTED=false

# Security & Auth Lockout (Phase 5)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300

# Private Push Notifications (ntfy / Tailscale)
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Vision & Camera (Phase 6A)
VISION_ENABLED=true
VISION_MODEL=moondream:latest
ALLOW_EXTERNAL_IMAGES=false
OCR_FALLBACK_ENABLED=false
TEMP_IMAGE_DIR=data/tmp_vision

# ==============================================================================
# Telegram Bot Interface Settings
# ==============================================================================
TELEGRAM_BOT_TOKEN=
MY_TELEGRAM_USER_ID=
WHISPER_MODEL=base.en
TTS_VOICE=en-US-JennyNeural
VAULT_DIR=./vault
NINO_MODE=companion

# ==============================================================================
# Security Scanner & Multimodal Vision Settings
# ==============================================================================
# VirusTotal API (v3) key for automated URL and file malware reputation checks
# Sign up at https://www.virustotal.com/gui/join-us to get a free personal API key.
VIRUSTOTAL_API_KEY=

# 8GB RAM Optimized Setup (Under 1.8GB memory footprint & auto-unload)
OLLAMA_MODEL=gemma2:2b
OLLAMA_VISION_MODEL=moondream
OLLAMA_KEEP_ALIVE=1m



