# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Numeric Telegram User ID (Get it by messaging @userinfobot or @rawdatabot)
# Messages from ANY other Telegram account will be rejected/dropped for privacy
MY_TELEGRAM_USER_ID=your_telegram_user_id_here

# ==============================================================================
# Ollama API Settings (100% Local, Private, and Offline)
# ==============================================================================
# Ollama service endpoint (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 8GB RAM Optimized Setup
OLLAMA_MODEL=gemma2:2b
OLLAMA_VISION_MODEL=moondream
OLLAMA_KEEP_ALIVE=1m

# ==============================================================================
# Local-Only Architecture (100% Local on Ollama - Zero Cloud LLM Dependencies)
# ==============================================================================
OLLAMA_HOST=http://127.0.0.1:11434

# Default interaction mode: 'companion' (The Cool One), 'work' (concise/task-first), or 'focus'
NINO_MODE=companion


# ==============================================================================
# Voice & Audio Pipeline Settings
# ==============================================================================
# faster-whisper model size ('tiny.en', 'base.en', 'small.en', 'medium.en')
WHISPER_MODEL=base.en

# edge-tts voice name ('en-US-JennyNeural', 'en-US-GuyNeural', 'en-US-AriaNeural')
TTS_VOICE=en-US-JennyNeural

# Default voice reply preference (false = text only by default, toggle on with /voice)
TELEGRAM_VOICE_REPLY_DEFAULT=false

# ==============================================================================
# Authorized Vault Folder (Strict Sandbox)
# ==============================================================================
# Directory for private notes accessible via the confirmation-gated vault tool
VAULT_DIR=./vault

# ==============================================================================
# Security Scanner & Multimodal Ingestion Settings
# ==============================================================================
# VirusTotal API (v3) key for automated URL and file malware reputation checks
# Sign up at https://www.virustotal.com/gui/join-us to get a free personal API key.
VIRUSTOTAL_API_KEY=

# Local / Cloud Vision Settings for Image Ingestion
OLLAMA_VISION_MODEL=llama3.2-vision

# ==============================================================================
# Sticker Reaction & Reply Settings
# ==============================================================================
# Optional default public Telegram sticker pack name for fallback replies
TELEGRAM_DEFAULT_STICKER_SET=
# Whether to send an accompanying witty text comment alongside sticker replies (default: false)
TELEGRAM_STICKER_REPLY_TEXT=false
